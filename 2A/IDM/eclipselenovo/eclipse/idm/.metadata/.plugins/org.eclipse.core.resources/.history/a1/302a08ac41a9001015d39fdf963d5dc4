[comment encoding = 'UTF-8' /]
[module totina('http://petrinet')]

[template public generateElement(aPetriNet : PetriNet)]
[comment @main/]
[file (aPetriNet.name.concat('.net'), false, 'UTF-8')]

net [aPetriNet.name/]

[comment --- Places --- /]
[for (p : Place | aPetriNet.objet->select(oclIsKindOf(Place))->collect(oclAsType(Place)))]
pl p[p.name /] ([p.token/])
[/for]

[comment --- Transitions --- /]
[for (t : Transition | aPetriNet.objet->select(oclIsKindOf(Transition))->collect(oclAsType(Transition)))]
[t.toTinaTransition()/]
[/for]

[/file]
[/template]


[template public toTinaTransition(t : Transition)]
[let tmin : Integer = if t.temp_min->notEmpty() then t.temp_min->any(true) else 0 endif ]
[let tmax : Integer = if t.temp_max->notEmpty() then t.temp_max->any(true) else 0 endif ]

tr t[t.name/] [tmin/],[tmax/]
[let inputs : OrderedSet(Place) =
    if t.Predecessor->notEmpty() then
        t.Predecessor
        ->collect(a | a.Predecessor_Place)
        ->select(p | not p.oclIsUndefined())
        ->asOrderedSet()
    else
        OrderedSet{}
    endif
]
[if (inputs->notEmpty())]
  [for (p : Place | inputs) separator(' ')]
    [p.name/]
  [/for]
[/if]
->
[let outputs : OrderedSet(Place) =
    if t.Successor->notEmpty() then
        t.Successor
        ->collect(a | a.Successor_Place)
        ->select(p | not p.oclIsUndefined())
        ->asOrderedSet()
    else
        OrderedSet{}
    endif
]
[if (outputs->notEmpty())]
  [for (p : Place | outputs) separator(' ')]
    [p.name/]
  [/for]
[/if]
[/let]
[/let]

[/let]
[/let]
[/template]
