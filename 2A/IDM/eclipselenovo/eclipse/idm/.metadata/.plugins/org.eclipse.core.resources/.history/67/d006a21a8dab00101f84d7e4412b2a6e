[comment encoding = 'UTF-8' /]
[module totina('http://petrinet')]
[template public generateElement(aPetriNet : PetriNet)]
[comment @main/]
[file (aPetriNet.name.concat('.net'), false, 'UTF-8')]
net [aPetriNet.name/]
[comment --- Places --- /]
[for (p : Place | aPetriNet.objet->select(oclIsKindOf(Place))->collect(oclAsType(Place)))]
pl p[p.name /] ([p.token/])
[/for]
[comment --- Transitions --- /]
[for (t : Transition | aPetriNet.objet->select(oclIsKindOf(Transition))->collect(oclAsType(Transition)))]
[t.toTinaTransition()/]
[/for]
[/file]
[/template]
[template public toTinaTransition(t : Transition)]
[let inputArcs : OrderedSet(Arc) = if t.Predecessor->notEmpty() then t.Predecessor->asOrderedSet() else OrderedSet{} endif]
[let outputArcs : OrderedSet(Arc) = if t.Successor->notEmpty() then t.Successor->asOrderedSet() else OrderedSet{} endif]
[let inputs : OrderedSet(Place) = inputArcs->collect(a | a.Predecessor_link)->select(p | not p.oclIsUndefined())->asOrderedSet()]
[let outputs : OrderedSet(Place) = outputArcs->collect(a | a.Successor_link)->select(p | not p.oclIsUndefined())->asOrderedSet()]
tr t[t.name/] ['['/][tmin/],[if (tmax=-1)]w[else][tmax/][/if][']'/] [for (p : Place | inputs) separator(' ')]p[p.name/][/for] -> [for (p : Place | outputs) separator(' ')][p.name/][/for][/let][/let][/let][/let][/let][/let]
[/template]