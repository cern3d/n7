grammar fr.n7.PDL1 with org.eclipse.xtext.common.Terminals
generate pDL1 "http://www.n7.fr/PDL1"

Process :
	'process' name=ID '{'
	    processElements+=ProcessElement*
	'}' ;

ProcessElement :
	WorkDefinition | WorkSequence | Guidance | Ressources;
	
Ressources : 
	'r' name=ID
	amount=INT ;
	
RessourceUsage :
	'ru' quantity=INT
		'used by' workdefinition=[WorkDefinition]
		'from' ressource=[Ressources] ;

WorkDefinition :
	'wd' name=ID;

WorkSequence :
	'ws' linkType=WorkSequenceType
		'from' predecessor=[WorkDefinition]
		'to' successor=[WorkDefinition] ;

Guidance :
	'note' texte=STRING ;

enum WorkSequenceType :
	start2start='s2s'
	| finish2start='f2s'
	| start2finish='s2f'
	| finish2finish='f2f'
	;
	
	
rule R2PetriNet {
	from ressource: SimplePDL!Ressource    
	to
  	  p_ressource: PetriNet!Place(name <- ressource.name,
  	  	token <- ressource.quantite)
}

rule rs2PetriNet {
	from amount : SimplePDL!UtilisationRessources
	to
	a_demande : PetriNet!Arc(
  	  Predecessor_link <- amount.ressource,
  	  Successor_link <-thisModule.resolveTemp(amount.workdefinition,'transition_start'),
	  token <- amount.nbOccurences
  	  ),
	a_libere :  PetriNet!Arc(
  	  Successor_link <- amount.ressource,
  	  Predecessor_link <-thisModule.resolveTemp(amount.workdefinition,'transition_finish'),
	  token <- amount.nbOccurences
  	  )  		 
  	 
}