# ---- 1. Cohérence des états ----
[] -( (pConception_ready /\ pConception_running)
    \/ (pConception_running /\ pConception_finished)
    \/ (pConception_ready /\ pConception_finished) );

[] -( (pRedactionDoc_ready /\ pRedactionDoc_running)
    \/ (pRedactionDoc_running /\ pRedactionDoc_finished)
    \/ (pRedactionDoc_ready /\ pRedactionDoc_finished) );

[] -( (pProgrammation_ready /\ pProgrammation_running)
    \/ (pProgrammation_running /\ pProgrammation_finished)
    \/ (pProgrammation_ready /\ pProgrammation_finished) );

[] -( (pRedactionTests_ready /\ pRedactionTests_running)
    \/ (pRedactionTests_running /\ pRedactionTests_finished)
    \/ (pRedactionTests_ready /\ pRedactionTests_finished) );

# ---- 2. Une activité terminée n’évolue plus ----
[] (pConception_finished => [] -(tConception_start \/ tConception_finish) );
[] (pRedactionDoc_finished => [] -(tRedactionDoc_start \/ tRedactionDoc_finish) );
[] (pProgrammation_finished => [] -(tProgrammation_start \/ tProgrammation_finish) );
[] (pRedactionTests_finished => [] -(tRedactionTests_start \/ tRedactionTests_finish) );

