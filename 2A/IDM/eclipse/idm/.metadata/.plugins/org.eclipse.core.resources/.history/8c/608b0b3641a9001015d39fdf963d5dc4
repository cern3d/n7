[comment encoding = 'UTF-8' /]
[module totina('http://petrinet')]

[template public generateElement(aPetriNet : PetriNet)]
[comment @main/]
[file (aPetriNet.name +('.net'), false, 'UTF-8')]

net [aPetriNet.name/]

[comment --- Places --- /]
[for (p : Place | aPetriNet.objet->select(oclIsKindOf(Place))->collect(oclAsType(Place)))]
pl p[p.name /] ([p.token/])
[/for]

[comment --- Transitions --- /]
[for (t : Transition | aPetriNet.objet->select(oclIsKindOf(Transition))->collect(oclAsType(Transition)))]
[t.toTinaTransition()/]
[/for]

[/file]
[/template]


[template public toTinaTransition(t : Transition)]
tr t[p.name/] [t.temp_min/],[t.temp_max/] 
[let inputs : OrderedSet(Place) =
    if t.Predecessor->notEmpty() then
        t.Predecessor
        ->collect(a | a.Predecessor_Place)
        ->select(p | not p.oclIsUndefined())
        ->asOrderedSet()
    else
        OrderedSet{}
    endif
]
[if (inputs->notEmpty())]
  [for (p : Place | inputs) separator(' ')]
    [p.name/]
  [/for]
[/if]
->
[let outputs : OrderedSet(Place) =
    if t.Successor->notEmpty() then
        t.Successor
        ->collect(a | a.Successor_Place)
        ->select(p | not p.oclIsUndefined())
        ->asOrderedSet()
    else
        OrderedSet{}
    endif
]
[if (outputs->notEmpty())]
  [for (p : Place | outputs) separator(' ')]
    [p.name/]
  [/for]
[/if]
[/let]
[/let]
[/template]



[template public toStateTransitionTime(t : Transition)]
[if (t.temp_min->notEmpty())]
    ['['/][t.temp_min-> any(true)/]
        [if (t.temp_max->notEmpty())]
            ,[t.temp_max-> any(true)/]]
        [else]
            ,w['['/]
        [/if]]
[else]
    [if (t.temp_max->notEmpty())]
        ['['/][t.temp_max-> any(true)/]]
    [else]
        ['['/] 0,0[']'/]
    [/if]
[/if]
[/template]


[template public inputPlaces(t : Transition)]
[comment @main/]
[let inputs : OrderedSet(Place) =
    if t.Predecessor->notEmpty() then
        t.Predecessor
        ->collect(a | a.Predecessor_Place)
        ->select(p | not p.oclIsUndefined())
        ->asOrderedSet()
    else
        OrderedSet{}
    endif
]
[for (p : Place | inputs)]
[p.name/][if (not p.token.oclIsUndefined())][if (p.token > 0)]* [p.token/][/if][/if] 
[/for]
[/let]
[/template]


[template public outputPlaces(t : Transition)]
[let outputs : OrderedSet(Place) =
    if t.Successor->notEmpty() then
        t.Successor
        ->collect(a | a.Successor_Place)
        ->select(p | not p.oclIsUndefined())
        ->asOrderedSet()
    else
        OrderedSet{}
    endif
]
[for (p : Place | outputs)]
[p.name/][if (not p.token.oclIsUndefined())][if (p.token > 0)]* [p.token/][/if][/if] 
[/for]
[/let]
[/template]